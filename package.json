{
  "name": "dsh-plugin-page-zh",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DSH（the agent harness）插件页中文汉化：把「设置 → 插件」里每个插件的名称和简介在本地显示为中文。完全离线、零网络、零付费；不改任何插件包、不影响插件升级、只在本地渲染时替换显示文本。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "i18n",
    "zh-cn",
    "localization",
    "translation"
  ],
  "license": "MIT",
  "author": "dsh-plugin-page-zh contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tunny1985/dsh-plugin-page-zh.git"
  },
  "scripts": {
    "build": "node build.cjs",
    "check": "node build.cjs --check && node --check client.js",
    "test": "node test/e2e.cjs"
  },
  "files": [
    "index.js",
    "client.js",
    "dictionary.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "homepage": "https://github.com/Tunny1985/dsh-plugin-page-zh#readme",
  "bugs": {
    "url": "https://github.com/Tunny1985/dsh-plugin-page-zh/issues"
  }
}
